<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.jogoseletronicos.model.Jogo" %>
<!DOCTYPE html>
<html>
<head>
    <title>Detalhes do Jogo</title>
    <link rel="stylesheet" href="<%= request.getContextPath() %>/css/header.css">
</head>
<body>

    <jsp:include page="header.jsp" />

    <%
        Jogo jogo = (Jogo) request.getAttribute("jogo");
        String mensagem = (String) request.getAttribute("mensagem");

        if (jogo != null) {
    %>
        <div class="container-fluid py-5">
        <div class="mx-auto" style="max-width: 100%;">
            <% if (jogo != null) { %>
                <div class="card shadow-lg border-0 p-5">
                    <div class="row g-5 align-items-center">
                        <div class="col-md-6 text-center">
                            <img src="<%= contextPath + "/" + jogo.getImagemJogo() %>" alt="Arte do Jogo" 
                                 class="img-fluid rounded w-70" style="max-height: 1000px; object-fit: cover;">
                        </div>
                        <div class="col-md-6">
                            <h1 class="fw-bold mb-4"><%= jogo.getTitulo() %></h1>
                            <p class="fs-2"><span>Feito por </span> <strong><%= jogo.getDesenvolvedor() %></strong><span> em </span> <%= jogo.getAnoLancamento()%></p>
                            <hr>
                            <p class="fs-2"><strong>Gênero:</strong> <%= jogo.getGenero() %></p>
                            <p class="fs-2"><strong>Sinopse:</strong> <%= jogo.getSinopse() %></p>
                            <p class="fs-2"><strong>Idioma:</strong> <%= jogo.getIdioma() %></p>
                            <p class="fs-2"><strong>Plataforma:</strong> <%= jogo.getPlataforma() %></p>
                            <p class="fs-2"><strong>Classificação Indicativa:</strong> <%= jogo.getClassificacaoIndicativa() %></p>
							<a href="editar-jogo?titulo=<%= jogo.getTitulo() %>">Editar</a><br><br>
        					<form action="remover-jogo" method="POST">
           						 <input type="hidden" name="titulo" value="<%= jogo.getTitulo() %>">
            					 <button type="submit">Remover</button>
       						 </form>
                            
                        </div>
                    </div>
                </div>

        </div>
            <% } else { %>
                <div class="alert alert-warning text-center fs-4 mt-5">
                    <%= mensagem != null ? mensagem : "Jogo não encontrado ou não carregado corretamente." %>
                </div>
            <% } %>
        </div>
  
</body>
</html>
