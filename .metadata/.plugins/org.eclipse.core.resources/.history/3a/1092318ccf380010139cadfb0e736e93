<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.jogoseletronicos.model.Jogo" %>
<!DOCTYPE html>
<html>
<head>
    <title>Detalhes do Jogo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="<%= request.getContextPath() %>/css/header.css">
</head>
<body class="bg-light">

    <jsp:include page="header.jsp" />

    <%
        String username = (String) session.getAttribute("username");
        String contextPath = request.getContextPath();

        Jogo jogo = (Jogo) request.getAttribute("jogo");
        String mensagem = (String) request.getAttribute("mensagem");
    %>

    <div class="container-fluid py-5">
        <div class="mx-auto" style="max-width: 60%;">
            <% if (jogo != null) { %>
                <div class="card shadow-lg border-0 p-5">
                    <div class="row g-5 align-items-center">
                        <div class="col-md-6 text-center">
                            <img src="<%= contextPath + "/" + jogo.getImagemJogo() %>" alt="Arte do Jogo" 
                                 class="img-fluid rounded w-50" style="max-height: 1000px; object-fit: cover;">
                        </div>
                        <div class="col-md-6">
                            <h1 class="fw-bold mb-4"><%= jogo.getTitulo() %></h1>
                            <p class="fs-4"><span>Feito por </span> <strong><%= jogo.getDesenvolvedor() %></strong><span> em </span> <%= jogo.getAnoLancamento()%></p>
                            <hr>
                            <p class="fs-4"><strong>Gênero:</strong> <%= jogo.getGenero() %></p>
                            <p class="fs-4"><strong>Sinopse:</strong> <%= jogo.getSinopse() %></p>
                            <p class="fs-4"><strong>Idioma:</strong> <%= jogo.getIdioma() %></p>
                            <p class="fs-4"><strong>Plataforma:</strong> <%= jogo.getPlataforma() %></p>
                            <p class="fs-4"><strong>Classificação Indicativa:</strong> <%= jogo.getClassificacaoIndicativa() %></p>

                            <% if (username != null) { %>
                                <form action="adicionar-jogo" method="POST" class="mt-4">
                                    <input type="hidden" name="titulo" value="<%= jogo.getTitulo() %>">
                                    <button type="submit" class="btn btn-primary btn-lg w-100">Adicionar à minha Lista</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="alert alert-warning text-center fs-4 mt-5">
                    <%= mensagem != null ? mensagem : "Jogo não encontrado ou não carregado corretamente." %>
                </div>
            <% } %>
        </div>
    </div>

</body>
</html>
