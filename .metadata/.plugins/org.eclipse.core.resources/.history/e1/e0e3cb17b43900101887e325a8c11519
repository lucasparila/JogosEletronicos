<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="true" %>
<%@ page import="com.jogoseletronicos.model.Usuario" %>
<!DOCTYPE html>
<html>
<head>
    <title>Perfil do Usuário</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
 
</head>
<body>

<jsp:include page="header.jsp" />

<div class="container my-5" style="max-width: 700px;">
    <div class="card shadow p-4">
        <h2 class="mb-4 text-center">Perfil do Usuário</h2>

        <%
            Usuario usuario = (Usuario) session.getAttribute("username");
            if (usuario == null) {
        %>
            <div class="alert alert-warning text-center" role="alert">
                Nenhum usuário logado. Por favor, faça login para ver seu perfil.
            </div>
        <%
            } else {
        %>

        <dl class="row mb-4">
            <dt class="col-sm-4">Nome:</dt>
            <dd class="col-sm-8"><%= usuario.getNome() %></dd>

            <dt class="col-sm-4">E-mail:</dt>
            <dd class="col-sm-8"><%= usuario.getEmail() %></dd>

            <dt class="col-sm-4">Data de Nascimento:</dt>
            <dd class="col-sm-8"><%= usuario.getDataNascimento() %></dd>

            <dt class="col-sm-4">Nome de Usuário:</dt>
            <dd class="col-sm-8"><%= usuario.getUsername() %></dd>
        </dl>

        <div class="d-flex justify-content-center">
            <a href="<%= request.getContextPath() %>/view/editarUsuario.jsp" class="btn btn-primary px-4">
                Atualizar Perfil
            </a>
        </div>

        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
