<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.jogoseletronicos.model.Jogo" %>
<!DOCTYPE html>
<html>
<head>
    <title>Editar Jogo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="<%= request.getContextPath() %>/css/header.css">
</head>
<body class="bg-light">

    <jsp:include page="header.jsp" />

    <%
        Jogo jogo = (Jogo) request.getAttribute("jogo");
    %>

    <div class="container py-5">
        <div class="card shadow-lg border-0 p-5 mx-auto" style="max-width: 800px;">
            <h2 class="text-center mb-4 fw-bold">Editar Jogo</h2>
            <form action="<%= request.getContextPath() %>/editar-jogo" method="post">
                <div class="mb-3">
                    <label class="form-label">Título</label>
                    <input type="text" class="form-control" name="titulo" value="<%= jogo.getTitulo() %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Desenvolvedor</label>
                    <input type="text" class="form-control" name="desenvolvedor" value="<%= jogo.getDesenvolvedor() %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Ano de Lançamento</label>
                    <input type="text" class="form-control" name="anoLancamento" value="<%= jogo.getAnoLancamento() %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Gênero</label>
                    <input type="text" class="form-control" name="genero" value="<%= jogo.getGenero() %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Sinopse</label>
                    <textarea class="form-control" name="sinopse" rows="4" required><%= jogo.getSinopse() %></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Idioma</label>
                    <input type="text" class="form-control" name="idioma" value="<%= jogo.getIdioma() %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Plataforma</label>
                    <input type="text" class="form-control" name="plataforma" value="<%= jogo.getPlataforma() %>" required>
                </div>
                <div class="mb-4">
                    <label class="form-label">Classificação Indicativa</label>
                    <input type="text" class="form-control" name="classificacaoIndicativa" value="<%= jogo.getClassificacaoIndicativa() %>" required>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-success btn-sm fs-5 px-4">Atualizar Jogo</button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
