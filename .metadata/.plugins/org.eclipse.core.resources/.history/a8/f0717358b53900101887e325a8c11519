<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.jogoseletronicos.model.Usuario" %>
<!DOCTYPE html>
<html>
<head>
    <title>Perfil do Usuário</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <jsp:include page="header.jsp" />

    <%
        Usuario usuario = (Usuario) session.getAttribute("usuarioLogado");
        String contextPath = request.getContextPath();
    %>

    <div class="container-fluid py-5">
        <div class="mx-auto w-100 px-5">
            <% if (usuario != null) { %>
                <div class="card shadow-lg border-0 p-5">
                    <h2 class="fw-bold mb-4 text-center">Perfil do Usuário</h2>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-semibold">Nome:</label>
                        <div class="col-sm-9">
                            <p class="form-control-plaintext"><%= usuario.getNome() %></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-semibold">Email:</label>
                        <div class="col-sm-9">
                            <p class="form-control-plaintext"><%= usuario.getEmail() %></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-semibold">Data de Nascimento:</label>
                        <div class="col-sm-9">
                            <p class="form-control-plaintext"><%= usuario.getDataNascimento() %></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-semibold">Username:</label>
                        <div class="col-sm-9">
                            <p class="form-control-plaintext"><%= usuario.getUsername() %></p>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a href="<%= contextPath %>/view/atualizarPerfil.jsp" class="btn btn-primary btn-lg">
                            Atualizar Perfil
                        </a>
                    </div>
                </div>
            <% } else { %>
                <div class="alert alert-warning text-center fs-4 mt-5">
                    Nenhum usuário logado.
                </div>
            <% } %>
        </div>
    </div>

</body>
</html>
