<%@page import="com.jogoseletronicos.model.Usuario"%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="true" %>

<!DOCTYPE html>
<html>
<head>
    <title>Header</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
</head>
<body>

<%
    Usuario usuario = (Usuario) session.getAttribute("usuarioLogado");
    String contextPath = request.getContextPath();
%>

<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="<%= contextPath %>/index.jsp">GameSystem</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="<%= contextPath %>/index.jsp">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= contextPath %>/view/sobre-sistema.jsp">Sobre o Sistema</a>
                    </li>
                    <% if (username != null) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= contextPath %>/listar-jogos">Meus jogos</a>
                    </li>
                    <% } %>
                </ul>

                <form class="d-flex me-3" action="<%= contextPath %>/buscar-jogo" method="post" role="search">
                    <input class="form-control me-2" type="search" name="titulo" placeholder="Buscar jogo..." aria-label="Buscar jogo" required>
                    <button class="btn btn-outline-primary" type="submit">Buscar</button>
                </form>

                <% if (username != null) { %>
                    <div class="d-flex align-items-center gap-3">
                        <a href= "<%= contextPath %>/view/paginaUsuario.jsp"  class="fw-semibold"><%= username %>!</a>
                        <a href="<%= contextPath %>/logout" class="btn btn-danger btn-sm">Sair</a>
                    </div>
                <% } else { %>
                    <a href="<%= contextPath %>/view/login.jsp" class="btn btn-primary">Login</a>
                <% } %>
            </div>
        </div>
    </nav>
</header>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

